# Copy to .env and fill. Never commit the filled copy.

POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

# Amoy testnet only. For mainnet use `--ledger` or a keystore; never a raw key.
DEPLOYER_PRIVATE_KEY=

# Deployment parameters
GOVERNANCE=       # Safe multisig. Must not be an EOA on mainnet.
GUARDIAN=         # Separate key, separate person, separate hardware.
TREASURY=
QUOTE_TOKEN=      # USDC. Defaults to Polygon PoS USDC.e if unset.
BOND_TOKEN=       # Builder bond token.

# ─── HyperEVM ────────────────────────────────────────────────────────────
#
# Chain 998 (testnet) or 999 (mainnet). `script/hyperliquid/Deploy.s.sol`
# refuses any other chain id, and resolves USDC from `block.chainid` rather
# than from here, so there is deliberately no USDC variable: a mismatch
# between the script and `hyper-evm-lib` would send deposits to a token the
# bridge path does not use, and would look like the bridge silently failing.
HYPEREVM_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
HYPEREVM_MAINNET_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Deploy.s.sol reads GOVERNANCE, GUARDIAN and TREASURY above, plus:
PLATFORM_BUILDER=  # Receives the platform's half of the execution fee.

# VerifyDeploy.s.sol reads these, filled in from the deploy output.
REGISTRY=
WHITELIST=
FACTORY=

# After deploying, two governance actions remain before orders work:
#   1. registry.setVaultFactory(FACTORY)   -- one-shot, from GOVERNANCE
#   2. queue + execute a market on the whitelist (48 h timelock)
# Deposits succeed before step 2. Orders do not.
#
# A large deploy needs HyperEVM big blocks (1 min, 30M gas), not small
# blocks (1 s, 3M gas). A deploy that reverts on gas is usually this.
